{
  "name": "Score",
  "short_name": "Score",
  "description": "A free Guitar Pro player for practice. Slow a song down, loop a section, mute or solo tracks. No account, works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0f14",
  "theme_color": "#0b0f14",
  "categories": ["education", "music", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/octet-stream": [".gp", ".gpx", ".gp3", ".gp4", ".gp5"],
        "application/vnd.recordare.musicxml+xml": [".musicxml", ".xml"],
        "application/vnd.recordare.musicxml": [".mxl"]
      }
    }
  ]
}
